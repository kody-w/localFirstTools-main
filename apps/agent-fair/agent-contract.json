    },
    "agent_fair_submit_attraction": {
      "maps_to": "local.submit-attraction",
      "writes": "local-proposal-branch"
    }
  },
  "prohibitions": [
    "external-network",
    "real-money",
    "nonpublic-data",
    "GODD-data",
    "biometric-data",
    "remote-shutdown",
    "direct-canonical-write"
  ],
  "schema": "rappterzoo-agent-worlds-fair-contract/1",
